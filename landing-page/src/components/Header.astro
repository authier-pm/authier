---
import { getCanonicalPath, navigation, site } from '../config'
import Icon from './Icon.astro'

const currentPath = getCanonicalPath(Astro.url.pathname)
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Authier home">
      <span class="brand-mark" aria-hidden="true">
        <img src="/brand/authier-logo.png" alt="" width="34" height="34" />
      </span>
      <span>authier</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a
          class:list={{ active: currentPath.startsWith(item.href) }}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="github-link" href={site.githubUrl} target="_blank" rel="noreferrer">
        <Icon name="github" size={18} />
        <span>GitHub</span>
      </a>
      <a class="button button-small" href="/download">
        Get Authier
        <Icon name="arrow" size={17} />
      </a>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/download">Download</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: rgba(7, 10, 10, 0.76);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .site-header::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
    content: '';
  }

  .header-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 730;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(105, 230, 204, 0.45);
    border-radius: 10px;
    background: #1fd7d0;
    box-shadow: 0 0 24px rgba(62, 221, 205, 0.14);
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .desktop-nav,
  .header-actions {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    gap: 30px;
  }

  .desktop-nav a,
  .github-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 560;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active,
  .github-link:hover {
    color: var(--text);
  }

  .header-actions {
    gap: 18px;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: grid;
    width: 42px;
    height: 42px;
    cursor: pointer;
    list-style: none;
    place-content: center;
    gap: 5px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary span {
    display: block;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
  }

  .mobile-menu nav {
    position: absolute;
    top: 52px;
    right: 0;
    display: grid;
    width: min(260px, calc(100vw - 32px));
    overflow: hidden;
    padding: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: rgba(13, 18, 18, 0.98);
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu nav a {
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .mobile-menu nav a:hover {
    background: var(--surface-raised);
    color: var(--text);
  }

  @media (max-width: 880px) {
    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
