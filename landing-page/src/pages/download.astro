---
import Icon from '../components/Icon.astro'
import PageHero from '../components/PageHero.astro'
import { site } from '../config'
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'Download Authier'
const description =
  'Install the Authier password manager extension for Chrome, Firefox, Microsoft Edge, or Firefox for Android, then open the web vault.'

const browsers = [
  {
    name: 'Google Chrome',
    label: 'Chrome Web Store',
    href: site.chromeUrl,
    note: 'For Chrome and Chromium-based desktop browsers.',
    icon: '/browser/chrome.png'
  },
  {
    name: 'Mozilla Firefox',
    label: 'Firefox Add-ons',
    href: site.firefoxUrl,
    note: 'Available for Firefox desktop and Firefox for Android.',
    icon: '/browser/firefox.png'
  },
  {
    name: 'Microsoft Edge',
    label: 'Microsoft Edge Add-ons',
    href: site.edgeUrl,
    note: 'Install directly from the Microsoft Edge Add-ons store.',
    icon: '/browser/edge.png'
  }
] as const

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Chrome, Firefox, Microsoft Edge, Android',
  description,
  url: `${site.url}/download`,
  downloadUrl: browsers.map(({ href }) => href),
  isAccessibleForFree: true
}
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="Download Authier"
    title="Start with your browser."
    description="Choose your browser extension, create a vault, and make that browser your first device. Start on your phone if you want it to become the initial master device."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Download' }
    ]}
  />

  <section class="section shell">
    <div class="browser-grid">
      {browsers.map((browser) => (
        <a class="browser-card card" href={browser.href} target="_blank" rel="noreferrer">
          <img
            class="browser-icon"
            src={browser.icon}
            alt=""
            width="56"
            height="56"
            decoding="async"
          />
          <div>
            <small>{browser.label}</small>
            <h2>{browser.name}</h2>
            <p>{browser.note}</p>
          </div>
          <span class="external-arrow"><Icon name="arrow" size={20} /></span>
        </a>
      ))}
    </div>

    <div class="platform-note">
      <p><strong>Desktop:</strong> use Chrome, Firefox, or Edge on Windows, macOS, or Linux.</p>
      <p><strong>Android:</strong> use the official Firefox add-on in Firefox for Android.</p>
    </div>
  </section>

  <section class="section section-border">
    <div class="shell start-layout">
      <div>
        <p class="eyebrow">First-time setup</p>
        <h2 class="section-heading">Three steps to an encrypted vault.</h2>
        <p class="section-copy">
          Your first browser becomes the trusted starting point and initial
          master device for the account. You can move that role later, but
          beginning on the device you expect to keep nearby saves that step.
        </p>
      </div>

      <ol class="setup-list">
        <li>
          <span>01</span>
          <div><h3>Install the extension</h3><p>Use the official store listing for your browser.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Create your account</h3><p>Choose a strong, unique master password that you can remember.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Add another device</h3><p>Request access there, then approve it from a device you already trust.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-border">
    <div class="shell support-history card">
      <div>
        <p class="eyebrow">Current support versus the old roadmap</p>
        <h2>Use the store links above as the source of truth.</h2>
      </div>
      <div>
        <p>
          The previous website recommended Kiwi Browser for Android and said
          native Android, macOS, Windows, and Linux apps were coming in Q4 2023.
          It also linked an early iOS build. Those statements are historical,
          not the current download promise.
        </p>
        <p>
          <a href="https://github.com/kiwibrowser/src.next/blob/kiwi/README.md" target="_blank" rel="noreferrer">Kiwi Browser is now archived</a>
          and no longer maintained. Firefox for Android has an official Authier
          listing, so it is the supported mobile browser path shown here.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-border">
    <div class="shell vault-callout card">
      <div class="vault-icon"><Icon name="lock" size={27} /></div>
      <div>
        <p class="eyebrow">Already have an account?</p>
        <h2>Use Authier in the web vault.</h2>
        <p>Open the browser-based vault to view credentials, TOTP codes, devices, and security settings.</p>
      </div>
      <a class="button" href={site.vaultUrl}>
        Open web vault
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .browser-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .platform-note {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 24px;
    color: var(--text-subtle);
    font-size: 0.82rem;
  }

  .platform-note p {
    margin: 0;
  }

  .platform-note strong {
    color: var(--text-muted);
  }

  .browser-card {
    display: grid;
    min-height: 310px;
    align-content: start;
    padding: 28px;
    grid-template-columns: 1fr auto;
    text-decoration: none;
    transition:
      transform 220ms ease,
      border-color 220ms ease;
  }

  .browser-card:hover {
    transform: translateY(-5px);
    border-color: rgba(105, 230, 204, 0.26);
  }

  .browser-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 58px;
    grid-column: 1;
    object-fit: contain;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.3));
  }

  .external-arrow {
    grid-row: 1;
    grid-column: 2;
    color: var(--text-subtle);
    transition: color 180ms ease;
  }

  .browser-card:hover .external-arrow {
    color: var(--accent);
  }

  .browser-card small {
    color: var(--text-subtle);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .browser-card h2 {
    margin: 7px 0 0;
    font-size: 1.2rem;
    font-weight: 660;
    letter-spacing: -0.03em;
  }

  .browser-card p {
    margin: 12px 0 0;
    color: var(--text-subtle);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .start-layout {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(60px, 9vw, 120px);
  }

  .setup-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .setup-list li {
    display: grid;
    padding: 24px 0;
    grid-template-columns: 54px 1fr;
    border-bottom: 1px solid var(--border);
  }

  .setup-list li:first-child {
    padding-top: 0;
  }

  .setup-list > li > span {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
  }

  .setup-list h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .setup-list p {
    margin: 8px 0 0;
    color: var(--text-subtle);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .vault-callout {
    display: grid;
    align-items: center;
    padding: clamp(30px, 5vw, 54px);
    grid-template-columns: 64px 1fr auto;
    gap: 26px;
  }

  .support-history {
    display: grid;
    padding: clamp(30px, 5vw, 54px);
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(34px, 7vw, 90px);
  }

  .support-history h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 660;
    letter-spacing: -0.05em;
    line-height: 1.06;
  }

  .support-history > div:last-child {
    color: var(--text-muted);
  }

  .support-history > div:last-child p {
    margin: 0 0 18px;
    line-height: 1.78;
  }

  .support-history > div:last-child p:last-child {
    margin-bottom: 0;
  }

  .support-history a {
    color: var(--accent);
    text-underline-offset: 4px;
  }

  .vault-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid rgba(105, 230, 204, 0.2);
    border-radius: 16px;
    background: rgba(105, 230, 204, 0.07);
    color: var(--accent);
  }

  .vault-callout h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 660;
    letter-spacing: -0.05em;
  }

  .vault-callout div > p:last-child {
    max-width: 650px;
    margin: 12px 0 0;
    color: var(--text-subtle);
  }

  @media (max-width: 900px) {
    .browser-grid {
      grid-template-columns: 1fr;
    }

    .browser-card {
      min-height: 230px;
    }

    .browser-icon {
      margin-bottom: 34px;
    }

    .start-layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .support-history {
      grid-template-columns: 1fr;
    }

    .vault-callout {
      align-items: start;
      grid-template-columns: 58px 1fr;
    }

    .vault-callout .button {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .vault-callout {
      grid-template-columns: 1fr;
    }
  }
</style>
