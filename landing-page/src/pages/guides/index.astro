---
import Icon from '../../components/Icon.astro'
import PageHero from '../../components/PageHero.astro'
import { site } from '../../config'
import { guides } from '../../data/guides'
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Password Manager Guides'
const description =
  'Practical guides to password managers, built-in TOTP, trusted-device approval, browser autofill, vault migration, backups, and security trade-offs.'

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${site.url}/guides`
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: `${site.url}${guide.href}`
    }))
  }
]
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="Password manager guides"
    title="Make the threat model understandable."
    description={description}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Guides' }
    ]}
    compact
  />

  <section class="section shell guide-grid">
    {guides.map((guide, index) => (
      <article class:list={['guide-card', 'card', { featured: index === 0 }]}>
        <div class="guide-meta">
          <span>{guide.category}</span>
          <span>{guide.readingTime}</span>
        </div>
        <h2><a href={guide.href}>{guide.title}</a></h2>
        <p>{guide.description}</p>
        <a class="read-link" href={guide.href}>
          Read guide
          <Icon name="arrow" size={18} />
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .guide-card {
    display: flex;
    min-height: 410px;
    padding: clamp(28px, 4vw, 44px);
    flex-direction: column;
  }

  .guide-card.featured {
    background:
      radial-gradient(circle at 90% 5%, rgba(105, 230, 204, 0.11), transparent 34%),
      linear-gradient(145deg, rgba(18, 25, 25, 0.88), rgba(10, 15, 15, 0.78));
  }

  .guide-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--text-subtle);
    font-size: 0.65rem;
    font-weight: 690;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-meta span:first-child {
    color: var(--accent);
  }

  h2 {
    margin: 58px 0 0;
    font-size: clamp(1.7rem, 3.5vw, 2.7rem);
    font-weight: 660;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .guide-card > p {
    margin: 20px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.72;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 8px;
    margin-top: auto;
    padding-top: 36px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 680;
    text-decoration: none;
  }

  @media (max-width: 780px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .guide-card {
      min-height: 350px;
    }
  }
</style>
