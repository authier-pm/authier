<ArticleLayout
  title="SMS codes, device recovery, and a steadier vault"
  description="Authier’s October update brings SMS codes to your browser, inline verification filling, configurable device recovery, and more reliable vault access."
  publishedAt="2026-10-06"
  readingTime="7 min read"
  imagePaths={[
    '/blog/october-2026/sms-verification-codes.png',
    '/blog/october-2026/inline-verification-codes.png',
    '/blog/october-2026/master-device-recovery.png'
  ]}
  socialImage={{
    path: '/blog/october-2026/sms-verification-codes.png',
    width: 1040,
    height: 760,
    alt: 'Authier showing masked SMS codes from Google Messages for Web and an Android phone',
    type: 'image/png'
