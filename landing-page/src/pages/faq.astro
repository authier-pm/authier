---
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'
import PageHero from '../components/PageHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'Password Manager FAQ'
const description =
  'Answers to common questions about Authier passwords, TOTP codes, encryption, trusted devices, browser support, pricing, and open-source development.'

const questions = [
  {
    question: 'What is Authier?',
    answer:
      'Authier is an open-source password manager for login credentials and time-based one-time password (TOTP) codes. It runs through browser extensions and a web vault.'
  },
  {
    question: 'Where is my vault encrypted?',
    answer:
      'Authier encrypts vault items in the client before synchronization. The API stores encrypted payloads rather than plaintext credentials or TOTP seeds.'
  },
  {
    question: 'What encryption does Authier use?',
    answer:
      'The current shared cryptography implementation derives a key with PBKDF2 using SHA-512 and 600,000 iterations, then encrypts vault data with AES-256-GCM.'
  },
  {
    question: 'How does a new device join my account?',
    answer:
      'A new browser creates a pending login request. An already-approved device reviews and approves that request before the new client completes enrollment and synchronizes the encrypted vault.'
  },
  {
    question: 'Can Authier store both passwords and 2FA codes?',
    answer:
      'Yes. Authier supports login credentials and TOTP secrets in the same encrypted vault. You should decide whether keeping both factors together matches your personal threat model.'
  },
  {
    question: 'Which browsers are supported?',
    answer:
      'Authier has official listings for Google Chrome, Mozilla Firefox, and Microsoft Edge. The Firefox add-on is also available for Firefox on Android.'
  },
  {
    question: 'Is Authier free?',
    answer:
      'Authier has a free tier. Optional monthly capacity packs add more credential or TOTP storage without changing the core encryption and device-approval features.'
  },
  {
    question: 'Is Authier independently audited?',
    answer:
      'Authier has not yet published an independent third-party security audit. Its source is public, but open source is not a substitute for a professional audit or a long operational history.'
  },
  {
    question: 'Can I use Authier with another password manager?',
    answer:
      'Yes. Browser extensions can sometimes compete for the same login fields, so you may need to disable autofill for one extension on specific sites.'
  },
  {
    question: 'Where can I report a security issue?',
    answer:
      'Use the responsible-disclosure instructions in the SECURITY.md file in the public Authier GitHub repository. It includes the project disclosure policy and PGP key fingerprint.'
  }
] as const

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer
    }
  }))
}
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="Frequently asked questions"
    title="The short answers, without the hand-waving."
    description={description}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'FAQ' }
    ]}
    compact
  />

  <section class="section narrow-shell faq-list">
    {questions.map(({ question, answer }, index) => (
      <details open={index === 0}>
        <summary>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h2>{question}</h2>
          <i><Icon name="chevron" size={20} /></i>
        </summary>
        <p>{answer}</p>
      </details>
    ))}
  </section>

  <CtaBand
    title="Still deciding whether Authier fits?"
    description="Read the security architecture, inspect the source, or install the extension and start with the free tier."
    primaryLabel="Read security architecture"
    primaryHref="/security"
    secondaryLabel="View source on GitHub"
    secondaryHref="https://github.com/authier-pm/authier"
  />
</BaseLayout>

<style>
  .faq-list {
    display: grid;
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: grid;
    min-height: 96px;
    align-items: center;
    cursor: pointer;
    grid-template-columns: 42px 1fr 24px;
    gap: 12px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary > span {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
  }

  summary h2 {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.18rem);
    font-weight: 630;
    letter-spacing: -0.02em;
  }

  summary i {
    color: var(--text-subtle);
    font-style: normal;
    transition: transform 180ms ease;
  }

  details[open] summary i {
    transform: rotate(180deg);
    color: var(--accent);
  }

  details > p {
    max-width: 690px;
    margin: -8px 0 32px 54px;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.8;
  }

  @media (max-width: 560px) {
    summary {
      grid-template-columns: 32px 1fr 20px;
    }

    details > p {
      margin-left: 44px;
    }
  }
</style>
